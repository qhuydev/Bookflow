# Cau hinh chi danh cho local development cua BookFlow.
# Sao chep file nay thanh .env va thay POSTGRES_PASSWORD bang gia tri local manh.
# Khong dung password mau nay cho staging hoac production.
COMPOSE_PROJECT_NAME=bookflow
POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_DB=bookflow
POSTGRES_USER=bookflow
POSTGRES_PASSWORD=change_me_for_local_development
POSTGRES_PORT=5432

# JWT signing key cho backend local. Không commit file key này.
BOOKFLOW_AUTH_KEY_ID=bookflow-local-2026
BOOKFLOW_AUTH_PRIVATE_KEY_LOCATION=file:C:/replace/with/bookflow-private.pem
BOOKFLOW_AUTH_PUBLIC_KEY_LOCATION=file:C:/replace/with/bookflow-public.pem

# CORS cho Next.js local; production phải đặt origin frontend chính xác, không dùng *.
BOOKFLOW_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Spring Boot/Flyway local. Dieu chinh port trong URL theo POSTGRES_PORT thuc te.
BOOKFLOW_DB_URL=jdbc:postgresql://127.0.0.1:5432/bookflow
BOOKFLOW_DB_USERNAME=bookflow
BOOKFLOW_DB_PASSWORD=change_me_for_local_development

# Redis local development. Khong dung password mau nay cho staging hoac production.
REDIS_IMAGE=redis:8.6.5-alpine
REDIS_PORT=6379
REDIS_PASSWORD=change_me_for_local_development
BOOKFLOW_REDIS_HOST=127.0.0.1

# Bao ve authentication local. Mac dinh fail-closed khi Redis khong san sang.
BOOKFLOW_AUTH_PASSWORD_RESET_TTL_MINUTES=30
BOOKFLOW_AUTH_RATE_LIMIT_ENABLED=true
BOOKFLOW_AUTH_RATE_LIMIT_FAIL_OPEN=false
BOOKFLOW_AUTH_RATE_LIMIT_WINDOW_SECONDS=60
BOOKFLOW_AUTH_RATE_LIMIT_ACCOUNT_LIMIT=5
BOOKFLOW_AUTH_RATE_LIMIT_IP_LIMIT=20
# De trong neu ung dung khong nam sau reverse proxy tin cay; nhieu IP cach nhau boi dau phay.
BOOKFLOW_AUTH_RATE_LIMIT_TRUSTED_PROXIES=

# Availability local. Lead time hiện là policy cấp ứng dụng cho đến khi có cấu hình nghiệp vụ riêng.
BOOKFLOW_AVAILABILITY_SLOT_STEP_MINUTES=15
BOOKFLOW_AVAILABILITY_DEFAULT_LEAD_TIME_MINUTES=0

# Booking lifecycle local development
BOOKFLOW_BOOKING_HOLD_MINUTES=10
BOOKFLOW_BOOKING_EXPIRY_BATCH_SIZE=100
BOOKFLOW_BOOKING_EXPIRY_INTERVAL=PT30S
BOOKFLOW_BOOKING_EXPIRY_ENABLED=true
