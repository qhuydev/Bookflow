# Cau hinh chi danh cho local development cua BookFlow.
# Sao chep file nay thanh .env va thay POSTGRES_PASSWORD bang gia tri local manh.
# Khong dung password mau nay cho staging hoac production.
COMPOSE_PROJECT_NAME=bookflow
POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_DB=bookflow
POSTGRES_USER=bookflow
POSTGRES_PASSWORD=change_me_for_local_development
POSTGRES_PORT=5432

# Spring Boot/Flyway local. Dieu chinh port trong URL theo POSTGRES_PORT thuc te.
BOOKFLOW_DB_URL=jdbc:postgresql://127.0.0.1:5432/bookflow
BOOKFLOW_DB_USERNAME=bookflow
BOOKFLOW_DB_PASSWORD=change_me_for_local_development

# Redis local development. Khong dung password mau nay cho staging hoac production.
REDIS_IMAGE=redis:8.6.5-alpine
REDIS_PORT=6379
REDIS_PASSWORD=change_me_for_local_development
